MODEL_DIR=python/models/llama-3.2-1b
ENGINE=build/engine
HF_MODEL=
ARCH=sm_89

MAX_SEQUENCES=4      # KV cache slots, one per in flight request
MAX_PROMPT_LEN=512   # longest prompt accepted, also sizes the scoring logit buffer
MAX_SEQ_LEN=1024     # prompt + generated, sizes the KV cache and rope tables. must be <= MAX_NUM_THREAD, the softmax reductions use one block per row
MAX_NUM_THREAD=1024  # max threads per block on this GPU
MAX_TOP_K=40         # sizes topKSample shared memory and caps --top-k

DEFAULT_TOP_K=40
DEFAULT_TEMPERATURE=0.8
DEFAULT_MAX_NEW_TOKENS=100
